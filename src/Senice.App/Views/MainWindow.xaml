<Window x:Class="Senice.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Senice.App.ViewModels"
        mc:Ignorable="d"
        Title="Senice &#x2014; Comment Stripper"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="860"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBackground}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Senice" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Remove comments and emoji from source files without changing their behavior." Foreground="{DynamicResource TextSecondary}" FontSize="13" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                             Width="420" VerticalContentAlignment="Center"
                             ToolTip="Drop a file or folder here, or choose one." />
                    <TextBlock Text="{Binding DetectedLanguage}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Browse File..." Command="{Binding BrowseFileCommand}" Margin="0,0,8,0" />
                    <Button Content="Browse Folder..." Command="{Binding BrowseFolderCommand}" />
                </StackPanel>

                <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <CheckBox Content="Remove comments" IsChecked="{Binding RemoveComments}" Margin="0,0,20,0" />
                    <CheckBox Content="Remove emoji from comments" IsChecked="{Binding RemoveEmojisInComments}" Margin="0,0,20,0" />
                    <CheckBox Content="Remove emoji from strings" IsChecked="{Binding RemoveEmojisInStrings}" Margin="0,0,20,0" />
                    <CheckBox Content="Preserve shebang lines" IsChecked="{Binding PreserveShebang}" Margin="0,0,20,0" />
                    <CheckBox Content="Backup before writing" IsChecked="{Binding BackupBeforeWrite}" Margin="0,0,20,0" />
                    <CheckBox Content="Skip uncertain files" IsChecked="{Binding SkipUncertainFiles}" Margin="0,0,20,0" />
                    <CheckBox Content="Include hidden files" IsChecked="{Binding IncludeHiddenFiles}" Margin="0,0,20,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Max depth:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MaxDepth}" Width="46" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <CheckBox Content="Dark theme" IsChecked="{Binding IsDarkTheme}" Margin="0,0,20,0" />
                </ItemsControl>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentFile}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}" />
                    <ProgressBar Height="10" Margin="0,6,0,0"
                                 Maximum="{Binding Total, Mode=OneWay}" Value="{Binding Processed, Mode=OneWay}" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}">
                        <Run Text="{Binding Processed, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding Total, Mode=OneWay}" /><Run Text=" files processed" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Run" Style="{StaticResource PrimaryButton}" MinWidth="110" Command="{Binding RunCommand}" Margin="0,0,8,0" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" FontSize="13" />
                <Button Content="Clear" Command="{Binding ClearResultsCommand}" Margin="12,0,0,0" Padding="10,4"
                        Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <ListView ItemsSource="{Binding Results}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Status" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="File" Width="430">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Language" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Language}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Encoding" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DetectedEncoding}" Foreground="{DynamicResource TextSecondary}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Comments" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CommentsRemoved}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Emoji" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EmojisRemoved}" HorizontalAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Diff" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="View Diff" Padding="8,3" Command="{Binding DataContext.ShowDiffCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Changed">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="5" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="12">
            Drag and drop a file or folder onto this window to begin. Backups are written next to each file as .senice.bak.
        </TextBlock>

        <Border Grid.Row="0" Grid.RowSpan="6"
                Background="{DynamicResource DropOverlayBackground}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="2"
                Visibility="Collapsed"
                x:Name="DropOverlay">
            <TextBlock Text="Drop to process" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
        </Border>
    </Grid>
</Window>
