<Window x:Class="Senice.App.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Senice.App.ViewModels"
        mc:Ignorable="d"
        Title="Diff"
        Height="680" Width="1180"
        MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="GutterText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="CodeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate DataType="{x:Type vm:DiffRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                <Setter Property="Background" Value="{DynamicResource DiffRemovedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter Property="Background" Value="{DynamicResource DiffAddedBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <TextBlock Grid.Column="0" Text="{Binding BeforeNumber}" Style="{StaticResource GutterText}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding BeforeText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CodeText}">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                    <Setter Property="Foreground" Value="{DynamicResource DiffRemovedTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="2" Text="{Binding AfterNumber}" Style="{StaticResource GutterText}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="3" Text="{Binding AfterText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CodeText}">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Added">
                                    <Setter Property="Foreground" Value="{DynamicResource DiffAddedTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding FileName}" />
                <Run Text="{Binding Language, StringFormat=' ({0})'}" Foreground="{DynamicResource TextSecondary}" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock FontSize="12" Foreground="{DynamicResource DiffAddedTextBrush}">
                    <Run Text="+" /><Run Text="{Binding Added, Mode=OneWay}" /><Run Text="  added" />
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{DynamicResource DiffRemovedTextBrush}" Margin="16,0,0,0">
                    <Run Text="-" /><Run Text="{Binding Removed, Mode=OneWay}" /><Run Text="  removed" />
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Before" Style="{StaticResource GutterText}" Padding="0,6,8,6" FontWeight="SemiBold" />
                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Before" Padding="6,6" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" />
                </Border>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="After" Style="{StaticResource GutterText}" Padding="0,6,8,6" FontWeight="SemiBold" />
                <Border Grid.Row="0" Grid.Column="3" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="After" Padding="6,6" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" />
                </Border>

                <ScrollViewer Grid.Row="1" Grid.ColumnSpan="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
